{
  "name": "accounting-backend",
  "version": "1.0.0",
  "description": "Accounting System Backend API",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && tsc && npx prisma migrate deploy",
    "build:render": "npm install && npx prisma generate && npx tsc && npx prisma migrate resolve --rolled-back 20260513000000_comprehensive_gap_fill 2>/dev/null; npx prisma migrate deploy",
    "build:local": "tsc && prisma generate && npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:generate:local": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.4.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.8.4",
    "node-cron": "^3.0.3",
    "prisma": "^5.22.0",
    "serverless-http": "^4.0.0",
    "typescript": "^5.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
